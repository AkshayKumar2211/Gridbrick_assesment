# All settings are optional; defaults live in app/config.py.

# auto = live from Elexon, falling back to data/snapshot.json.gz | live | snapshot
DATA_SOURCE=auto

# Comma-separated origins allowed to call the API (the Vercel URL in production).
CORS_ORIGINS=*

# Business scope: purchase decisions made on these UK dates.
DECISION_DATE_FROM=2026-01-01
DECISION_DATE_TO=2026-01-31

# Default decision time on D-1 (N2EX GB day-ahead gate closure).
DEFAULT_DECISION_TIME=09:50

# Delivery day D starts at this hour (UK) on D-1; 23 for GB day-ahead, 0 for calendar days.
DELIVERY_DAY_START_HOUR=23

# Trailing window of known errors used for the bias adjustment and uncertainty range.
ERROR_LOOKBACK_DAYS=14
